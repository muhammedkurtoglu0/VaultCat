# Vault Pentest Tool — Environment Variables
# Copy this to .env and fill in your values.

# ── LLM Providers (set at least one) ──────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ── Optional: Web Search ─────────────────────────────────────
# Tavily provides 1000 free queries/month.
# If not set, DuckDuckGo (free, no key) is used as fallback.
TAVILY_API_KEY=
